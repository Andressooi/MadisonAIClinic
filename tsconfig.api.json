{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Must match how the function actually runs: Vercel compiles api/*.ts to
       ESM (package.json is type: module) and runs it under plain Node, which
       requires explicit file extensions on relative imports. "bundler" here
       accepted extensionless specifiers that then failed at runtime with
       ERR_MODULE_NOT_FOUND, so nodenext is the honest setting. */
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
